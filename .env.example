# RawBox 环境配置文件
# 复制此文件为 .env 并根据实际情况修改

# 服务配置
PORT=18080
DATA_DIR=./data

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# API Tokens（多个用逗号分隔）
API_TOKENS=token1,token2,token3

# User-Agent 过滤
UA_WHITELIST=
UA_BLACKLIST=Bot,Spider

# 会话配置
SESSION_SECRET=your-secret-key-change-this
SESSION_TIMEOUT=3600

# 时区
TZ=Asia/Shanghai
